# Add these in Vercel Project Settings > Environment Variables
POSTGRES_URL=postgresql://...
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Deposit account details shown to users before they mark a bank transfer as paid
DEPOSIT_BANK_NAME=YOUR BANK NAME
DEPOSIT_ACCOUNT_NAME=YOUR ACCOUNT NAME
DEPOSIT_ACCOUNT_NUMBER=0000000000
DEPOSIT_PHONE_NUMBER=YOUR PHONE NUMBER

# Investment plan configuration (decimal daily rates, e.g. 0.005 = 0.5%/day)
PLAN_STARTER_RATE=0.10
PLAN_GROWTH_RATE=0.05
PLAN_PREMIUM_RATE=0.04
PLAN_STARTER_TERM_DAYS=15
PLAN_GROWTH_TERM_DAYS=31
PLAN_PREMIUM_TERM_DAYS=41
INVESTMENT_TERM_DAYS=30
WITHDRAWAL_MIN=2000
CRON_SECRET=replace-with-a-long-random-secret
